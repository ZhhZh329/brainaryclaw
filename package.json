{
  "name": "weekrep-pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:vendor && node scripts/build.mjs",
    "build:vendor": "esbuild scripts/innovation-force-entry.mjs --bundle --format=iife --global-name=InnovationForce --minify --outfile=public/vendor/innovation-force.js && esbuild scripts/markdown-entry.mjs --bundle --format=iife --global-name=ReportMarkdown --minify --outfile=public/vendor/report-markdown.js",
    "analyze": "node scripts/analyze.mjs",
    "test:innovation": "node scripts/innovation.test.mjs",
    "sync-full": "npm run build && npm run analyze && npm run build",
    "sync": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "d3-force": "3.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1"
  }
}
